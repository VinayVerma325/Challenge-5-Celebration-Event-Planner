# ==========================================
# Celebration & Event Planner Environment Configuration
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Database Configuration
# Provide a MongoDB Atlas connection string or local MongoDB instance.
# If omitted or unconnectable, an automatic in-memory MongoDB will be used for seamless demo/testing.
MONGODB_URI=mongodb://localhost:27017/celebration_planner

# Authentication (JWT)
# Use a strong, random 32+ character secret in production
JWT_SECRET=demo_jwt_secret_change_in_production_key_12345
JWT_EXPIRES_IN=7d

# Google Gemini API Configuration
# Get your API key from Google AI Studio: https://aistudio.google.com/
# If left empty, the server automatically uses transparent, high-fidelity fallback demo planning data.
GEMINI_API_KEY=
