{
  "name": "celebration-planner-server",
  "version": "1.0.0",
  "description": "Backend API for Celebration & Event Planner with Gemini GenAI integration",
  "main": "dist/server.js",
  "scripts": {
    "dev": "node ../node_modules/tsx/dist/cli.mjs watch src/server.ts",
    "build": "node ../node_modules/typescript/bin/tsc",
    "start": "node dist/server.js",
    "test": "node ../node_modules/vitest/vitest.mjs run",
    "test:watch": "node ../node_modules/vitest/vitest.mjs",
    "lint": "node ../node_modules/typescript/bin/tsc --noEmit"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.10.7",
    "@types/supertest": "^6.0.2",
    "mongodb-memory-server": "^10.1.3",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.0"
  }
}
